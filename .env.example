# Copy to .env and change what you need. Every value below is the default.

# Server
PORT=8080
LOG_LEVEL=info
# Robots at Munich, Berlin and Frankfurt (1 to 3 sites, 1 to 1000 robots each)
FLEET_ROBOTS_PER_SITE=20,50,500

# Simulator
SERVER_URL=http://localhost:8080
SIM_SEED=7
SIM_TICK_MS=500
# Set to off for perfectly behaved robots: no dropouts, late or duplicate reports, errors or lost robots.
SIM_FAULTS=on

# Web dev server: where /api and /ws are forwarded
API_TARGET=http://localhost:8080
