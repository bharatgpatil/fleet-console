{
  "name": "fleet-console",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,sim,web -c blue,magenta,green \"npm:dev -w @fleet/server\" \"npm:dev -w @fleet/simulator\" \"npm:dev -w @fleet/web\"",
    "build": "npm run build -w @fleet/web",
    "start": "npm run start -w @fleet/server",
    "serve": "concurrently -k -n server,sim -c blue,magenta \"npm:start -w @fleet/server\" \"npm:start -w @fleet/simulator\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
